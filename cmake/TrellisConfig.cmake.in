@PACKAGE_INIT@
set(Trellis_GIT_COMMIT "@TRELLIS_GIT_COMMIT@")
set(Trellis_MSVC_VERSION "@MSVC_VERSION@")
set(Trellis_BACKEND "@TRELLIS_BUILD_BACKEND@")
set(Trellis_TENSORRT "@TRELLIS_TENSORRT@")
set(Trellis_BUILD_TYPE "@CMAKE_BUILD_TYPE@")
set_and_check(Trellis_RUNTIME_DIR "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_BINDIR@")
if(MSVC AND NOT MSVC_VERSION STREQUAL Trellis_MSVC_VERSION)
  message(FATAL_ERROR "Trellis C++ SDK requires MSVC ${Trellis_MSVC_VERSION}; rebuild the SDK with this toolchain")
endif()
if(MSVC AND CMAKE_BUILD_TYPE AND NOT CMAKE_BUILD_TYPE STREQUAL Trellis_BUILD_TYPE)
  message(FATAL_ERROR "Trellis SDK configuration is ${Trellis_BUILD_TYPE}; use the matched compiler/runtime configuration")
endif()
if(MSVC AND CMAKE_MSVC_RUNTIME_LIBRARY MATCHES "^MultiThreaded(Debug)?$")
  message(FATAL_ERROR "Trellis SDK requires the dynamic MSVC CRT (/MD)")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/TrellisTargets.cmake")
